# environments
.venv/
__pycache__/
*.pyc
.DS_Store

# temporary preview pages and scratch files
.preview/
.scratch/

# generator downloads and raw traces: large, regenerable from the ledger's prompts (the contact sheet refs/sheet.jpg
# and the style reference are tracked)
assets/*/refs/gen/
assets/*/refs/trace/
assets/*/out/scratch/
# retina screenshots are big; the 1x ones and the contact sheet are enough in git
assets/*/out/review/*/context@2x.png
assets/*/out/*/review/*/context@2x.png
# real PC-98 rooms and edits derived from them are third-party art: keep only scripts and notes
assets/panda-room/real-candidates/*
!assets/panda-room/real-candidates/*.py
!assets/panda-room/real-candidates/README.md
# easel: look sheets embed reference crops (third-party art), previews are site screenshots, index maps regenerate;
# mahou-pc paints into a third-party room, so all of its renders stay local (its passages and journal are tracked)
easel/pieces/*/out/look.png
easel/pieces/*/out/preview/
easel/pieces/*/out/index.npy
easel/pieces/mahou-pc/out/
easel/pieces/panda-room/out/

# full-page previews include third-party scene art; keep only the sidebar crops
assets/room-icon/out/review/*/context*.png
